<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(CI)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(CI)' != 'true'">net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.2" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <!-- Supplies the XPlat Code Coverage collector the pipeline runs with.
         Without it the tests pass and report no coverage at all. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Without a substitute library there is no way to isolate a
     collaborator, so every test reaches the real one and "unit test"
     means integration test with extra steps. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- Layering assertions run as ordinary tests, so the architecture is
         enforced by the same command as everything else rather than by a
         separate tool nobody remembers to run. -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PosTestCicdBackend\PosTestCicdBackend.csproj" />
  </ItemGroup>

</Project>
